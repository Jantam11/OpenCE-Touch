+				broker_flush(broker);
+				if (broker->state != _broker_ready || broker->output_size + size + TOPIC_SIZE + 6 > OUTPUT_BUFFER_SIZE - 1024) continue;
+				broker_publish(broker, relay->send_topic, packet, size);
+				sent = 1;
+			}
+			return sent;
+		}
+	return 0;
+
+}
