+static void relay_topic(const unsigned char *key, char *topic)
+{
+	unsigned char hash[P2P_SHA256_SIZE];
+	p2p_hmac_sha256(key, P2P_SHA256_SIZE, "tunnel-relay", 12, hash);
+	strcpy(topic, "hceu/r/");
+	p2p_hex(hash, 16, topic + 7);
